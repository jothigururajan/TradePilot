# TradePilot NSE Environment Configuration
# Copy this file to `.env` if you want to override defaults, configure Telegram alerts, or add paid broker API keys.

TRADEPILOT_DATA_PROVIDER=yfinance
TRADEPILOT_HISTORY_YEARS=2
TRADEPILOT_DB_PATH=data_store/tradepilot_nse.db

# Optional Telegram Bot EOD Alert Credentials (from @BotFather and @userinfobot)
TRADEPILOT_TELEGRAM_BOT_TOKEN=
TRADEPILOT_TELEGRAM_CHAT_ID=

# Optional Paid Broker / Data Provider Credentials (Zerodha Kite / Upstox / TrueData)
TRADEPILOT_API_KEY=
TRADEPILOT_API_SECRET=
